# VSCode
.vscode/

# ============================================================
# Local environment / secrets
# ============================================================

.env
.env.local
.env.*.local

env/*.env
!env/*.env.example

auth.json

# Local SSL
rootCA.pem
rootCA-key.pem


# ============================================================
# Magento source
# Ignore Magento distribution by default
# ============================================================

src/*

# Keep Composer project definition
!src/composer.json
!src/composer.lock

# Keep Magento app directory so selected files can be tracked
!src/app/
src/app/*

# Custom modules
!src/app/code/
!src/app/code/**

# Custom themes
!src/app/design/
!src/app/design/**

# Magento deployment configuration
!src/app/etc/
src/app/etc/*
!src/app/etc/config.php

# Never commit machine-specific Magento configuration
src/app/etc/env.php


# ============================================================
# Magento runtime / dependencies
# ============================================================

src/vendor/
src/generated/
src/var/
src/pub/static/
src/pub/media/
src/node_modules/


# ============================================================
# Docker generated / local files
# ============================================================

compose.versions.yaml
*.bak


# ============================================================
# Node
# ============================================================

node_modules/


# ============================================================
# IDE / OS / temporary
# ============================================================

.idea/

.DS_Store
Thumbs.db
desktop.ini

*.log
*.tmp
*.swp
*.swo
*~
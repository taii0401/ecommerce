# Default text files
* text=auto

# Linux / Docker shell scripts must use LF
*.sh text eol=lf
bin/* text eol=lf

# Docker / configuration files
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf
Makefile text eol=lf

# PHP / Magento
*.php text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf